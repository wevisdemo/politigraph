{
	"name": "politigraph",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"prepare": "husky",
		"dev": "turbo dev",
		"build": "NODE_ENV=production turbo build",
		"lint": "turbo lint",
		"check": "turbo check",
		"format": "prettier --write --ignore-unknown --ignore-path .gitignore .",
		"migrate": "turbo migrate",
		"test:unit": "NODE_ENV=test turbo test:unit",
		"test:db:up": "docker compose -f compose.test.yml up -d --force-recreate --wait --quiet-pull",
		"test:db:down": "docker compose -f compose.test.yml down",
		"test:integration": "bun run test:db:up && NODE_ENV=test turbo test:integration; code=$?; bun run test:db:down; exit $code",
		"test:e2e": "bun run test:db:up && NODE_ENV=test turbo test:e2e; code=$?; bun run test:db:down; exit $code",
		"db:pull": "rsync -azvP --delete politigraphdb:/var/server/neo4j/data .neo4j"
	},
	"lint-staged": {
		"*": "prettier --write --ignore-unknown"
	},
	"packageManager": "bun@1.3.2",
	"dependencies": {
		"turbo": "^2.11.4"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@eslint/js": "^10.0.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@vue/test-utils": "^2.5.1",
		"astro-eslint-parser": "^2.1.0",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-astro": "^2.1.1",
		"happy-dom": "^20.14.5",
		"husky": "^9.1.7",
		"lint-staged": "^15.5.2",
		"prettier": "^3.9.9",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"typescript-eslint": "^8.70.1",
		"vitest": "^4.1.11"
	}
}
