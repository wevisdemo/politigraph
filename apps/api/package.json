{
	"name": "@politigraph/api",
	"version": "1.0.0",
	"scripts": {
		"dev": "bun run --watch --no-clear-screen src/index.ts",
		"build": "bun build --compile --minify --outfile dist/server src/index.ts && cp node_modules/bun-image-turbo-linux-x64-gnu/*.node dist",
		"lint": "eslint . --fix",
		"check": "bunx --bun tsc --noEmit",
		"test:unit": "bun test tests/unit",
		"test:integration": "bun test tests/integration",
		"test": "bun test"
	},
	"dependencies": {
		"@apollo/server": "^4.11.2",
		"@elysiajs/cors": "^1.4.0",
		"@escape.tech/graphql-armor": "^3.2.0",
		"@modelcontextprotocol/server": "2.0.0",
		"@politigraph/auth": "workspace:*",
		"@politigraph/config": "workspace:*",
		"@politigraph/graphql": "workspace:*",
		"bun-image-turbo-linux-x64-gnu": "^1.9.0",
		"elysia": "^1.4.16",
		"graphql": "^16.9.0",
		"imgkit": "^2.2.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@graphql-tools/schema": "^10.0.35",
		"@modelcontextprotocol/client": "2.0.0",
		"bun-types": "latest"
	}
}
