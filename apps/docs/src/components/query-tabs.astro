---
import { Code, Icon, TabItem, Tabs } from '@astrojs/starlight/components';
import { toPlaygroundUrl } from '@politigraph/graphql/playground-url';
import * as graphql from 'prettier/plugins/graphql';
import { format } from 'prettier/standalone';
import { GRAPHQL_ENDPOINT } from '../constants/site';
import { fetchGraphql } from '../utils/graphql';
import { getLanguage, useTranslations } from '../utils/i18n';
import QueryGraph from './query-graph.vue';

interface Props {
	query: string;
	variables?: string;
}

const { query, variables } = Astro.props;

const parsedVariables = variables ? JSON.parse(variables) : undefined;
const jsonResponse = await fetchGraphql(query, parsedVariables);

const flattenedData = Object.values(jsonResponse.data).flatMap((value) => {
	if (Array.isArray(value)) {
		return value.map((item) => ({
			...item,
		}));
	}
	return value;
});

const formattedQuery = await format(query, {
	parser: 'graphql',
	plugins: [graphql],
});

const t = useTranslations(getLanguage(Astro.locals.starlightRoute.locale));
const playgroundUrl = toPlaygroundUrl(
	GRAPHQL_ENDPOINT,
	formattedQuery.trim(),
	variables,
);

function formatJson(obj: object) {
	return JSON.stringify(obj, null, 2);
}
---

<div class="flex flex-col gap-2">
	<Tabs>
		<TabItem label="Visualization">
			<QueryGraph client:visible data={{ flattenedData }} />
		</TabItem>
		<TabItem label="Query">
			<Code
				code={formattedQuery}
				lang="graphql"
				class="md:h-128 overflow-y-auto"
			/>
		</TabItem>
		{
			variables && (
				<TabItem label="Variables">
					<Code
						code={formatJson(JSON.parse(variables))}
						lang="json"
						class="md:h-128 overflow-y-auto"
					/>
				</TabItem>
			)
		}
		<TabItem label="Response">
			<Code
				code={formatJson(jsonResponse)}
				lang="json"
				class="md:h-128 overflow-y-auto"
			/>
		</TabItem>
	</Tabs>

	<a
		href={playgroundUrl}
		class="flex flex-row items-center justify-end gap-1 text-xs text-(--sl-color-text-accent) hover:text-(--sl-color-white)"
	>
		<Icon name="external" />
		{t.openInPlayground}
	</a>
</div>
