---
import { Code, Icon, TabItem, Tabs } from '@astrojs/starlight/components';
import { toPlaygroundUrl } from '@politigraph/graphql/playground-url';
import * as graphql from 'prettier/plugins/graphql';
import { format } from 'prettier/standalone';
import { GRAPHQL_ENDPOINT } from '../constants/site';
import { fetchGraphql } from '../utils/graphql';
import { getLanguage, useTranslations } from '../utils/i18n';
import { builderSchema } from '../utils/query-builder/builder-schema';
import { canParseQuery } from '../utils/query-builder/parse';
import { toQueryParam } from '../utils/query-builder/url';
import QueryGraph from './query-graph.vue';

interface Props {
	query: string;
}

const { query } = Astro.props;

const jsonResponse = await fetchGraphql(query);

const flattenedData = Object.values(jsonResponse.data).flatMap((value) => {
	if (Array.isArray(value)) {
		return value.map((item) => ({
			...item,
		}));
	}
	return value;
});

const formattedQuery = await format(query, {
	parser: 'graphql',
	plugins: [graphql],
});

const { locale } = Astro.locals.starlightRoute;
const t = useTranslations(getLanguage(locale));

const localePrefix = locale ? '/' + locale : '';

const openLink = canParseQuery(builderSchema, query)
	? {
			href:
				localePrefix + '/query-builder' + toQueryParam(formattedQuery.trim()),
			label: t.openInQueryBuilder,
			icon: 'right-arrow' as const,
		}
	: {
			href: toPlaygroundUrl(GRAPHQL_ENDPOINT, formattedQuery.trim()),
			label: t.openInPlayground,
			icon: 'external' as const,
		};

function formatJson(obj: object) {
	return JSON.stringify(obj, null, 2);
}
---

<div class="flex flex-col gap-2">
	<Tabs>
		<TabItem label="Visualization">
			<QueryGraph client:visible data={{ flattenedData }} />
		</TabItem>
		<TabItem label="Query">
			<Code
				code={formattedQuery}
				lang="graphql"
				class="md:h-128 overflow-y-auto"
			/>
		</TabItem>
		<TabItem label="Response">
			<Code
				code={formatJson(jsonResponse)}
				lang="json"
				class="md:h-128 overflow-y-auto"
			/>
		</TabItem>
	</Tabs>

	<a
		href={openLink.href}
		class="flex flex-row items-center justify-end gap-1 text-xs text-(--sl-color-text-accent) hover:text-(--sl-color-white)"
	>
		<Icon name={openLink.icon} />
		{openLink.label}
	</a>
</div>
