---
import { Icon } from '@astrojs/starlight/components';
import StarlightPageTitle from '@astrojs/starlight/components/PageTitle.astro';
import { getLanguage, useTranslations } from '../utils/i18n';
import { hasMarkdownVersion } from '../utils/llms';

const { entry, locale } = Astro.locals.starlightRoute;
const t = useTranslations(getLanguage(locale));

const showMarkdownLink = hasMarkdownVersion(entry);
---

<div class="flex flex-row flex-wrap gap-2 items-end">
	<StarlightPageTitle />

	{
		showMarkdownLink && (
			<a
				href={`/${entry.id}.md`}
				class="ml-auto flex flex-row items-center gap-1 text-xs text-(--sl-color-text-accent) hover:text-(--sl-color-white)"
			>
				<Icon name="document" />
				{t.viewAsMarkdown}
			</a>
		)
	}
</div>
