---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ExploreGraph from '../../components/explore/explore-graph.vue';
import { getLanguage, useTranslations } from '../../utils/i18n';
import '../../styles/full-page.css';

export function getStaticPaths() {
	return [{ params: { locale: undefined } }, { params: { locale: 'en' } }];
}

const lang = getLanguage(Astro.params.locale);
const t = useTranslations(lang);
---

<StarlightPage
	frontmatter={{
		title: t.exploreTitle,
		description: t.exploreDescription,
		template: 'splash',
		tableOfContents: false,
		pagefind: false,
		prev: false,
		next: false,
	}}
>
	<ExploreGraph client:load lang={lang} />
</StarlightPage>
