{
	"name": "@politigraph/auth",
	"type": "module",
	"private": true,
	"exports": {
		"./auth": "./src/auth.ts",
		"./client": "./src/client.ts",
		"./db": "./src/db.ts",
		"./schema/*": "./src/schema/*.ts"
	},
	"scripts": {
		"generate": "bun run --bun better-auth generate -y --config src/auth.ts --output src/schema/auth.ts && bun run --bun drizzle-kit generate",
		"migrate": "bun scripts/migrate.ts",
		"lint": "eslint . --fix",
		"check": "tsc --noEmit",
		"seed": "bun run scripts/seed.ts"
	},
	"dependencies": {
		"@better-auth/api-key": "^1.7.18",
		"@politigraph/config": "workspace:*",
		"better-auth": "^1.7.18",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"postgres": "^3.4.9"
	},
	"devDependencies": {
		"auth": "^1.7.18"
	},
	"peerDependencies": {
		"typescript": "^5.9.3"
	}
}
